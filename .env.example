# Server
PORT=37200
WEB_ORIGIN=http://127.0.0.1:5174
APP_DB_PATH=./data/app.db
UPLOAD_DIR=./uploads

# Notion
NOTION_TOKEN=secret_xxxxxxxxxxxx
CHAPTER_DATABASE_ID=xxxxxxxxxxxxxxxxxxxx
ORIGINAL_PAGE_DB_ID=xxxxxxxxxxxxxxxxxxxx
RAW_MATERIALS_DATABASE_ID=xxxxxxxxxxxxxxxxxxxx
EXAM_QUESTIONS_DATABASE_ID=xxxxxxxxxxxxxxxxxxxx
OUTLINE_DATABASE_ID=xxxxxxxxxxxxxxxxxxxx

# Qwen / DashScope OpenAI-compatible API
QWEN_API_KEY=sk-xxxxxxxxxxxx
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_VISION_MODEL=qwen3-vl-flash
QWEN_TEXT_MODEL=qwen3-vl-flash

MOCK_ANALYSIS_PROVIDER=codex-luna
CODEX_LUNA_API_KEY=
CODEX_LUNA_BASE_URL=https://api.openai.com/v1
CODEX_LUNA_MODEL=gpt-5.6-luna
CODEX_LUNA_TIMEOUT_MS=12000

DEEPSEEK_ANALYSIS_API_KEY=
DEEPSEEK_ANALYSIS_BASE_URL=https://api.deepseek.com
DEEPSEEK_ANALYSIS_MODEL=deepseek-chat
DEEPSEEK_ANALYSIS_TIMEOUT_MS=12000

# Codex CLI；留空时会自动探测 PATH，以及 macOS ChatGPT/Codex App 的内置 CLI
CODEX_BIN=
CODEX_MODEL=
CODEX_TIMEOUT_MS=600000

# DeepSeek OpenAI-compatible API
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_TEACHING_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_MS=600000
DEEPSEEK_MAX_TOKENS=4000
DEEPSEEK_TEACHING_MAX_TOKENS=12000

# Auth
SESSION_SECRET=change-me
